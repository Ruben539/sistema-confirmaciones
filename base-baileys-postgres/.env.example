# Puerto del Bot Baileys de WhatsApp (Node.js)
PORT=3001

# Base de Datos (Mismos datos que en el .env de Laravel en el servidor)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=weddingcheck_db
DB_USERNAME=weddingcheck_user
DB_PASSWORD=TuPasswordSeguroProduccion

# Backend Laravel URL (URL interna o dominio con HTTPS)
LARAVEL_URL=https://confirmaciones.factosystem.com.py
LARAVEL_API_URL=https://confirmaciones.factosystem.com.py/api/rsvp/incoming-whatsapp

# IDs de soporte por defecto
SUPPORT_USER_ID=1
SUPPORT_DESARROLLADOR_ID=1

# Opcional: clave compartida con Laravel (mismo valor que WHATSAPP_WEBHOOK_SECRET en su .env). Vacía = sin clave.
WHATSAPP_WEBHOOK_SECRET=
# Interfaz donde escucha el bot (127.0.0.1 = solo accesible desde el mismo servidor)
BOT_HOST=127.0.0.1

# Pausas del bot entre mensajes (segundos). Primeros mensajes (invitaciones, recordatorios, avisos):
BOT_SEND_DELAY_SECONDS=15
# Respuestas a quien escribió: texto / con imagen (el pase QR al confirmar)
BOT_REPLY_MIN_SECONDS=4
BOT_REPLY_MAX_SECONDS=10
BOT_MEDIA_MIN_SECONDS=15
BOT_MEDIA_MAX_SECONDS=30
