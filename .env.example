APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Drive Storage Integration (Directamente en .env sin archivos en el repositorio)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# Opcional (alternativa para pegar el JSON completo en 1 sola línea):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=

# Spotify Integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_API_KEY=

VITE_APP_NAME="${APP_NAME}"


# Opcional: clave compartida con el bot de WhatsApp (mismo valor en base-baileys-postgres/.env).
# Si se deja vacía, el webhook funciona como siempre.
WHATSAPP_WEBHOOK_SECRET=

# Canal por defecto (avisos a planners/admin): "baileys" (bot propio) o "cloud" (API oficial de Meta).
# Cada evento elige su canal de invitaciones en Configurar evento (Automático / Solo bot / Solo oficial).
WHATSAPP_DRIVER=baileys
# false = todo por el bot (la API oficial queda apagada aunque tenga credenciales)
WHATSAPP_CLOUD_ENABLED=true
# Invitaciones/recordatorios por día que puede enviar el bot (el resto, por la API oficial en modo Automático)
WHATSAPP_BAILEYS_DAILY_LIMIT=30
WHATSAPP_CLOUD_PHONE_NUMBER_ID=1384928514702751
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=968233302417291
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_APP_SECRET=EAAepcGmCnX0BSt37lFN5JpCu3pGhkC2VLy4j6otqOa6sLVcbCssbNStPDi4l0rZAZCibVzKIzMliwMSI59UW9J0MvtAMTtsf4uBN5xSBBSAFZAPJslYX1lDe5ienrR1ZC>
WHATSAPP_CLOUD_VERIFY_TOKEN=e23d99e05a45504a53048882674490bda534eca321f40f7e
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=es
# Nombres de las plantillas aprobadas en WhatsApp Manager
WHATSAPP_TPL_INVITATION=saludo_invitacion
WHATSAPP_TPL_REMINDER=recordatorio_evento
WHATSAPP_TPL_PASS=pase_ingreso
WHATSAPP_TPL_NOTICE=aviso_mensaje

# Páginas legales (/privacidad, /terminos, /eliminar-datos)
LEGAL_BRAND=
LEGAL_OWNER=
LEGAL_EMAIL=
LEGAL_WHATSAPP=
